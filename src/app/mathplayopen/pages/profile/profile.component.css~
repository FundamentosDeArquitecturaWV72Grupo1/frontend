.user-profile {
  text-align: center;
  padding: 20px;
  background-color: #f9f9f9;
  border-radius: 10px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.profile-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-image {
  width: 150px; height: 150px;
  border-radius: 50%;
  margin-bottom: 20px;
}

.user-details {
  font-size: 1.2em;
}
