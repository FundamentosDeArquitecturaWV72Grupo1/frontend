<div class="bg-banner">
  <div class="content">
    <h1 class="title">Noticias</h1>
    <p class="description">Bienvenido a nuestra sección de noticias educativas, donde te mantenemos al tanto de los últimos desarrollos en el mundo de la educación. Aquí encontrarás artículos, informes y análisis sobre tendencias educativas, innovaciones pedagógicas, políticas educativas y eventos relevantes..</p>
  </div>
  <img class="image" src="https://cdn-icons-png.flaticon.com/512/3184/3184154.png" alt="imagen" />
</div>

<div class="news-container">
  <div *ngFor="let news of newsList" class="news-item">
    <img [src]="news.image" alt="News Image" class="news-image" />
    <h3>{{ news.title }}</h3>
    <p>{{ news.description }}</p>
    <p><strong>Autor:</strong> {{ news.author }}</p>
    <p><strong>Fuente:</strong> {{ news.source }}</p>
    <p><strong>Publicado:</strong> {{ news.publishedAt | date }}</p>
    <a *ngIf="news.url" [href]="news.url" target="_blank">Leer más</a>
  </div>
</div>
