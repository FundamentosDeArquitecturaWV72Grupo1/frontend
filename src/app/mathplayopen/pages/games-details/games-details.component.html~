<mat-card *ngIf="game" class="game-detail-card">
  <button mat-button class="back-button" (click)="goBack()">Back to Game List</button>
  <mat-card-content>
    <h3>{{game.title}}</h3>
    <div class="score-display">
      <h2>Current Score: {{ score }}</h2>
    </div>

    <div class="embed-container">
      <div [innerHTML]="safeEmbedCode"></div>
    </div>
    
    <p>{{ game.description }}</p>
    <p><strong>Topic:</strong> {{ game.topic }}</p>
    <p><strong>Rules:</strong> {{ game.rules }}</p>
  </mat-card-content>

  <div class="reviews-section">
    <app-create-review [gameId]="game.id" (reviewCreated)="reloadReviews()"></app-create-review>
    <h2>Reviews</h2>
    <app-review-list [gameId]="game.id"></app-review-list>
  </div>
</mat-card>
